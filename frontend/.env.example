NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional basemap/reference layer for the 2D map. The map stays fully
# usable with this disabled -- these are not required for Pixel Lane's
# own road-network rendering. See frontend/src/features/city-viewer/map/README.md.
NEXT_PUBLIC_MAP_BASEMAP_ENABLED=false
# A MapLibre style URL (e.g. a self-hosted style, or a provider's style
# URL if you have one). Never commit a real API key here.
NEXT_PUBLIC_MAP_STYLE_URL=
