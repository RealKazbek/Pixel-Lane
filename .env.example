# Root Docker Compose environment. Copy to .env and adjust values.
# Never commit a real .env file.

POSTGRES_DB=pixel_lane
POSTGRES_USER=pixel_lane
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://pixel_lane:change-me@postgres:5432/pixel_lane

BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000
BACKEND_ENVIRONMENT=development
BACKEND_DEBUG=true

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
